# Backend (Django)
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3100
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3100

# Database (local dev uses docker Postgres; prod uses Supabase)
POSTGRES_DB=central_crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Company defaults
COMPANY_DEFAULT_TIMEZONE=Asia/Kolkata
COMPANY_DEFAULT_CURRENCY=INR

# Session cookie
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=0

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
INTERNAL_API_BASE_URL=http://backend:8000/api/v1
FRONTEND_PORT=3100

# ---- Integrations (optional) --------------------------------------------
# Razorpay webhook secret (Dashboard → Webhooks → Add → copy the secret)
RAZORPAY_WEBHOOK_SECRET=

# SMTP (Gmail / Sendgrid / etc.) — leave EMAIL_HOST blank to use console backend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Central CRM <noreply@localhost>

# WhatsApp Business Cloud API (adapter is stubbed; values prepare config)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
